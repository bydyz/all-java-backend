<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>baseon-com_h2database_h2</artifactId>
  <version>1.0-SNAPSHOT</version>

  <!-- ==================== 属性配置 ==================== -->
  <!-- 定义项目级别的属性，用于统一管理版本号和编码配置 -->
  <properties>
    <java.version>17</java.version>                    <!-- Java 版本 -->
    <maven.compiler.source>17</maven.compiler.source>  <!-- 源码编译版本 -->
    <maven.compiler.target>17</maven.compiler.target>  <!-- 目标编译版本 -->
    <spring-boot.version>3.2.5</spring-boot.version>   <!-- Spring Boot 版本 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>      <!-- 源码编码 -->
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding> <!-- 报告编码 -->
  </properties>

  <!-- ==================== 依赖配置 ==================== -->
  <!-- dependencies: 项目运行时和编译时所需的依赖库 -->
  <dependencies>
    <!-- MyBatis-Plus 核心依赖（Spring Boot 3.x 专用版本） -->
    <!-- 提供 ORM 映射、CRUD 操作、条件构造器等功能 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.16</version>
    </dependency>

    <!-- MyBatis-Plus 分页插件依赖（3.5.x 版本需要单独引入） -->
    <!-- 提供分页查询功能，基于 JSqlParser 解析 SQL -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>3.5.16</version>
    </dependency>

    <!-- H2 内存数据库依赖（学习和测试用，无需安装外部数据库） -->
    <!-- 注意: H2 不完全支持 列注释和表注释功能 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>  <!-- 运行时使用，编译时不需要 -->
    </dependency>

    <!-- Lombok 依赖 -->
    <!-- 通过注解自动生成 getter/setter/构造器等样板代码 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>  <!-- 仅编译时使用，运行时不包含 -->
    </dependency>

    <!-- 引用 spring-boot 的 starter -->
    <!-- Spring Boot Starter Web（包含 REST API 支持） -->
    <!-- 提供 Spring MVC、内嵌 Tomcat、JSON 处理等 Web 开发功能 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <!-- JUnit 5 测试 API 依赖 -->
    <!-- 提供测试注解（@Test, @BeforeEach 等）和断言方法 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>  <!-- 仅测试时使用 -->
    </dependency>

    <!-- JUnit 5 测试引擎依赖（必须添加） -->
    <!-- 负责在 Maven 中发现和执行测试用例 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>  <!-- 仅测试时使用 -->
    </dependency>

    <!-- Spring Boot Test 测试支持依赖 -->
    <!-- 提供 @SpringBootTest、MockMvc 等 Spring 测试工具 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>  <!-- 仅测试时使用 -->
    </dependency>
  </dependencies>

  <!-- ==================== 依赖版本管理 ==================== -->
  <!-- dependencyManagement: 统一管理依赖版本，子模块可继承版本号而无需重复指定 -->
  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM (Bill of Materials) -->
      <!-- 导入 Spring Boot 依赖管理，自动管理 Spring 相关依赖的版本号 -->
      <!-- 这样在 dependencies 中使用 Spring 相关依赖时可以省略版本号 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- ==================== 构建配置 ==================== -->
  <!-- build: 配置项目构建相关的插件和设置 -->
  <build>
    <plugins>
      <!-- Spring Boot Maven 插件 -->
      <!-- 提供打包可执行 JAR/WAR 的能力，支持直接运行 java -jar xxx.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>org.rc.mybatisplus.Application</mainClass>  <!-- 主类入口 -->
          <excludes>
            <!-- 打包时排除 Lombok，因为它只在编译时使用 -->
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>  <!-- 重新打包为可执行 JAR -->
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Compiler Plugin - 配置 Java 编译器 -->
      <!-- 指定 Java 版本和源码编码，确保编译一致性 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>     <!-- 源码版本 -->
          <target>17</target>     <!-- 目标版本 -->
          <encoding>UTF-8</encoding>  <!-- 编码格式 -->
        </configuration>
      </plugin>

      <!-- Maven Surefire Plugin - 单元测试插件 -->
      <!-- 控制测试执行，这里配置为跳过测试（开发时可快速构建） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <skipTests>true</skipTests>  <!-- 跳过测试执行 -->
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
