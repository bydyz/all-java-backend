<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rc.rbac.mapper.DemoMapper">
    
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.rc.rbac.entity.Demo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="age" property="age"/>
        <result column="amount" property="amount"/>
        <result column="score" property="score"/>
        <result column="price" property="price"/>
        <result column="big_decimal" property="bigDecimal"/>
        <result column="enabled" property="enabled"/>
        <result column="status" property="status"/>
        <result column="birthday" property="birthday"/>
        <result column="deleted" property="deleted"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, description, age, amount, score, price, big_decimal, enabled, status,
        birthday, deleted, create_by, create_time, update_by, update_time
    </sql>
    
    <!-- 根据名称查询 -->
    <select id="selectByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM demos
        WHERE name = #{name} AND deleted = 0
    </select>
    
    <!-- 查询启用状态的记录 -->
    <select id="selectEnabledList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM demos
        WHERE status = 1 AND deleted = 0
        ORDER BY create_time DESC
    </select>
    
    <!-- 根据年龄范围查询 -->
    <select id="selectByAgeRange" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM demos
        WHERE age BETWEEN #{minAge} AND #{maxAge} AND deleted = 0
    </select>
    
</mapper>
